# TokenTerminal API (required for live protocol revenue data)
# Get your key at https://tokenterminal.com/products/api
TOKENTERMINAL_API_KEY=your_tokenterminal_bearer_token_here

# DefiLlama Pro API (required for historical fee charts, ETF data, yield pools)
# Subscribe at https://defillama.com/subscription ($300/month)
DEFILLAMA_API_KEY=your_defillama_pro_api_key_here

# CoinGecko Pro API key (free tier works without key but has stricter rate limits)
# Get your key at https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=your_coingecko_pro_api_key_here

# CoinGlass API key (required for derivatives data: open interest, funding rates, liquidations)
# Get your key at https://www.coinglass.com/pricing
COINGLASS_API_KEY=your_coinglass_api_key_here
